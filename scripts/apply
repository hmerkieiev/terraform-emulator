#!/usr/bin/env bash
# Apply the stack to a local emulator and read the resources back.
# The caller has to be the emulator's account before Terraform runs.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
# shellcheck source=emulator
. "${ROOT}/scripts/emulator"
trap cleanup EXIT

start_emulator
require_account
install_terraform
terraform -chdir=terraform init -input=false
terraform -chdir=terraform apply -input=false -auto-approve
python3 scripts/check
terraform -chdir=terraform plan -input=false -detailed-exitcode
echo "apply ok"
